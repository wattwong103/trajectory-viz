# ── Python ──────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Virtualenvs ─────────────────────────────────────────
.venv-viz/
.venv-viz-*/         # backup/recovery names (e.g. .venv-viz-old-broken)
.venv/
venv/
env/

# ── Frontend ────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
frontend/*.tsbuildinfo

# ── Database & data ─────────────────────────────────────
# Never commit the ingested DuckDB (gigabytes, regenerable)
*.duckdb
*.duckdb.wal
output/
data/

# ── Env files (never commit secrets) ────────────────────
.env
.env.local
.env.*.local

# ── OS / editor ─────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~

# ── Logs / temp ─────────────────────────────────────────
*.log
*.tmp
*.bak
/tmp/

# ── Phase 2C/2D generated artifacts ─────────────────────
# deck.gl vendor bundle (fetch via scripts/fetch_vendor.py; CI caches it)
scripts/vendor/
# baked building binaries (regenerate via scripts/build_buildings.py)
output/viz/buildings/
# generated single-HTML exports
exports/

# ── Dropbox conflict files ──────────────────────────────
*conflicted copy*

# ── Stray artifacts from external scripts (defensive) ───
# A rogue batch script on the host machine was creating files with
# mangled paths-as-names (e.g. "H:Dropboxobsidian-vaultAIedit-log.txt")
# that Dropbox syncs into whatever folder is open. Block them here.
*edit-log*.txt
*%date%*
H[:]Dropbox*
.e2e_db

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# ── Agent / spec tooling (per-tool scratch, never committed) ──
.claude/
.grok/
.codex/
.agents/
.mcp.json
AGENTS.md
openspec/
.mavis/
.harness/
.cursor/
.aider*

# ai-sdlc:runtime-gitignore
.ai-sdlc/state.db
.ai-sdlc/state/
.ai-sdlc/audit.jsonl

# ai-sdlc worktrees and the active-task sentinel are per clone (sh .githooks/setup.sh)
.worktrees/
